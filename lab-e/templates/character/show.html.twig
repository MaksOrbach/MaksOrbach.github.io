{% extends 'base.html.twig' %}

{% block title %}Character{% endblock %}

{% block body %}
    <h1 class="my-4">Character</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ character.id }}</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>{{ character.name }}</td>
        </tr>
        <tr>
            <th>Race</th>
            <td>{{ character.race }}</td>
        </tr>
        <tr>
            <th>Weapon</th>
            <td>{{ character.weapon }}</td>
        </tr>
        </tbody>
    </table>

    <div class="mb-3">
        <a class="btn btn-secondary" href="{{ path('app_character_index') }}">back to list</a>
        <a class="btn btn-primary" href="{{ path('app_character_edit', {'id': character.id}) }}">edit</a>
    </div>

    {{ include('character/_delete_form.html.twig') }}
{% endblock %}
