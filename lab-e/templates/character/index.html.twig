{% extends 'base.html.twig' %}

{% block title %}Character index{% endblock %}

{% block body %}
    <h1 class="my-4">Character index</h1>

    <table class="table table-striped table-hover">
        <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Race</th>
            <th>Weapon</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for character in characters %}
            <tr>
                <td>{{ character.id }}</td>
                <td>{{ character.name }}</td>
                <td>{{ character.race }}</td>
                <td>{{ character.weapon }}</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_character_show', {'id': character.id}) }}">show</a>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_character_edit', {'id': character.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_character_new') }}">Create new</a>
{% endblock %}
